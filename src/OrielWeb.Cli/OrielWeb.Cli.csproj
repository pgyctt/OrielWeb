<Project Sdk="Microsoft.NET.Sdk">

  <!--
    oriel —— 仓库自带的命令行工具（阶段 D 第 4 项）。

    两个子命令：
      doctor  把 ROADMAP 的「待真机验证清单」里**机器可判定**的那部分变成可执行检查，
              另外体检一个应用项目的配置（wwwroot 会不会被正确内嵌、有没有声明能力……）
      bundle  把一个已发布的 AOT 目录打成该平台的安装产物（.msi / .dmg / .AppImage）

    刻意**不引用 OrielWeb 库**：工具要能在"库还没构建"的环境里跑（它就是用来诊断环境的），
    而它需要的库知识只有"哪些平台需要什么"这类事实，不需要任何类型。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>oriel</AssemblyName>
    <RootNamespace>OrielWeb.Cli</RootNamespace>
    <Description>OrielWeb 的命令行工具：doctor（环境与项目体检）与 bundle（三平台安装产物）。</Description>
    <PackageId>OrielWeb.Cli</PackageId>
    <!-- 作为 dotnet tool 分发：dotnet tool install -g OrielWeb.Cli 之后命令名是 oriel -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>oriel</ToolCommandName>
    <PackageTags>webview;tauri;desktop;cross-platform;cli;tool</PackageTags>
    <PackageProjectUrl>https://github.com/pgyctt/OrielWeb</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pgyctt/OrielWeb</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CA1416：doctor 会按平台读注册表（Windows）与跑系统命令，平台守卫在运行期判断
         （OperatingSystem.IsWindows() 等），分析器无法追踪；与库里的处理一致。 -->
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
  </PropertyGroup>

</Project>

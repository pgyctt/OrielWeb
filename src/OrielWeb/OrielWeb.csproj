<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Description>OrielWeb — 类 Tauri 的 C# 跨平台系统 webview 核心库。零 C++ 组件、零 GUI 框架依赖、Native AOT 友好、零反射 IPC。</Description>
    <PackageTags>webview;tauri;desktop;cross-platform;nativeaot;aot;gtk;wkwebview</PackageTags>
    <PackageId>OrielWeb</PackageId>
    <Version>0.1.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/orielweb/OrielWeb</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Microsoft.Web.WebView2 包同时携带 WPF 程序集（Microsoft.Web.WebView2.Wpf.dll），其引用的
         WindowsBase 与 .NET 10 自带版本号不一致，会刷出大量 MSB3277。该冲突已由 MSBuild 自动解析
         （选择主版本），且本项目不使用 WPF/WinForms，故降级为消息。 -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="True" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- 三平台共用桥接脚本模板（占位符在建窗口时替换后注入，资源名 OrielWeb.Bridge.oriel-bridge.js） -->
    <EmbeddedResource Include="Bridge\oriel-bridge.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- 仅取 WebView2Loader.dll 原生位；托管互操作程序集不被引用，AOT 裁剪自动丢弃 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" ExcludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <!-- 源生成器以分析器形态进入引用方编译 -->
    <ProjectReference Include="..\OrielWeb.Generators\OrielWeb.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

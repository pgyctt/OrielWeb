<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Description>OrielWeb — 类 Tauri 的 C# 跨平台系统 webview 核心库。零 C++ 组件、零 GUI 框架依赖、Native AOT 友好、零反射 IPC。</Description>
    <PackageTags>webview;tauri;desktop;cross-platform;nativeaot;aot;gtk;wkwebview</PackageTags>
    <PackageId>OrielWeb</PackageId>
    <Version>0.1.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/orielweb/OrielWeb</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CA1416：Windows 平台层会调用带 SupportedOSPlatform 标注的 API（如 WebView2Aot 生成的接口）。
         本库通过 PlatformBackendFactory 做运行时平台分派，静态分析器无法追踪该守卫；
         逐类型标注会在跨平台入口处产生大规模传播，故在此统一抑制。 -->
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="True" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- 三平台共用桥接脚本模板（占位符在建窗口时替换后注入，资源名 OrielWeb.Bridge.oriel-bridge.js） -->
    <EmbeddedResource Include="Bridge\oriel-bridge.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本包只有一个用途：提供要内嵌的 WebView2Loader.dll（三个架构），其资产一概不要。
         它的 build/ 与 buildTransitive/ 目标会把 loader 复制进输出与发布目录、并牵入
         WPF/WinForms 托管程序集（后者引用与 .NET 10 版本不一致的 WindowsBase，刷出 MSB3277）；
         runtimes\win-*\native\WebView2Loader.dll 还会被 NuGet 的运行时资产解析另复制一份。
         这些都拦不住（WebView2NeverCopyLoaderDllToOutputDirectory 只作用于 Common.targets 的
         Content 项，管不到运行时资产），而 loader 已由下方内嵌，故整体排除 ExcludeAssets="all"。
         GeneratePathProperty 生成 $(PkgMicrosoft_Web_WebView2)，供内嵌时定位包内文件——
         该属性来自还原图，与资产排除无关。
         PrivateAssets="all" 同样必要：该包还带 buildTransitive/ 目标，会作用到**引用本库的项目**，
         在它们的输出/发布目录里再复制一份 loader。本库对外不暴露该包的任何类型（WebView2 互操作
         全部来自 WebView2Aot 的源生成绑定），因此它不该进入消费方的编译图。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40"
                      ExcludeAssets="all"
                      PrivateAssets="all"
                      GeneratePathProperty="true" />
    <PackageReference Include="WebView2Aot" Version="1.6.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebView2 运行时加载器：官方只提供「随 exe 放一份 loader DLL」或「内嵌为 .NET 资源」两条路，
         这里选后者，于是消费方无需任何发布配置即可得到单文件产物（否则会看到
         "Cannot load WebView2Loader.dll. Make sure it's present in the current's process path."）。
         资源名必须满足 WebView2Utilities 的匹配规则：含目标架构串、且以 WebView2Loader.dll 结尾；
         LogicalName 显式指定，避免因源文件位于 NuGet 缓存（项目目录之外）而得到不可预测的资源名。

         三个架构都嵌：库本身是 AnyCPU 构建，且 RID 不会随 ProjectReference 传到被引用的库，
         所以库里无法在编译期知道自己会被哪个架构的应用消费 —— 运行期由
         WebView2Utilities 按进程架构挑选对应资源。代价是单架构 AOT 产物会多带另外两份
         （约 273 KB），换来的是「任何架构的应用引用本库后直接单文件发布」。 -->
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll"
                      LogicalName="OrielWeb.runtimes.win-x64.native.WebView2Loader.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-arm64\native\WebView2Loader.dll"
                      LogicalName="OrielWeb.runtimes.win-arm64.native.WebView2Loader.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x86\native\WebView2Loader.dll"
                      LogicalName="OrielWeb.runtimes.win-x86.native.WebView2Loader.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- 源生成器以分析器形态进入引用方编译 -->
    <ProjectReference Include="..\OrielWeb.Generators\OrielWeb.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

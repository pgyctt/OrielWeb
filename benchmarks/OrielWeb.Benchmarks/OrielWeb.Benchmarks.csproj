<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- 基准项目不是产品代码：BDN 大量用反射，AOT/裁剪分析器在这里只会刷噪音。
         根 Directory.Build.props 默认开这三个开关，这里显式关掉。 -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <!-- 不参与打包；也不随 dotnet build OrielWeb.slnx 构建（见 docs/CODE-REVIEW-PLAN-2026-10-23.md 的 R3） -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OrielWeb\OrielWeb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内嵌站点：AssetLookup 基准要一个真实的资源表。前缀必须是 <程序集名>.wwwroot/，
         与包内 buildTransitive/OrielWeb.targets 生成的形态一致（显式 '/' 分隔符）。 -->
    <EmbeddedResource Include="wwwroot\**\*"
                      LogicalName="OrielWeb.Benchmarks.wwwroot/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

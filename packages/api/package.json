{
  "name": "@orielweb/api",
  "version": "0.4.12",
  "description": "OrielWeb 页面侧 API：模块名与 @tauri-apps/api 一一对应，迁移只需替换 import 前缀。",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/pgyctt/OrielWeb",
  "repository": {
    "type": "git",
    "url": "https://github.com/pgyctt/OrielWeb.git"
  },
  "keywords": [
    "orielweb",
    "tauri",
    "webview",
    "desktop",
    "cross-platform"
  ],
  "files": [
    "src",
    "types"
  ],
  "exports": {
    "./core": {
      "types": "./types/core.d.ts",
      "default": "./src/core.js"
    },
    "./event": {
      "types": "./types/event.d.ts",
      "default": "./src/event.js"
    },
    "./dpi": {
      "types": "./types/dpi.d.ts",
      "default": "./src/dpi.js"
    },
    "./path": {
      "types": "./types/path.d.ts",
      "default": "./src/path.js"
    },
    "./app": {
      "types": "./types/app.d.ts",
      "default": "./src/app.js"
    },
    "./fs": {
      "types": "./types/fs.d.ts",
      "default": "./src/fs.js"
    },
    "./opener": {
      "types": "./types/opener.d.ts",
      "default": "./src/opener.js"
    },
    "./notification": {
      "types": "./types/notification.d.ts",
      "default": "./src/notification.js"
    },
    "./autostart": {
      "types": "./types/autostart.d.ts",
      "default": "./src/autostart.js"
    },
    "./clipboard": {
      "types": "./types/clipboard.d.ts",
      "default": "./src/clipboard.js"
    },
    "./dialog": {
      "types": "./types/dialog.d.ts",
      "default": "./src/dialog.js"
    },
    "./window": {
      "types": "./types/window.d.ts",
      "default": "./src/window.js"
    },
    "./webviewWindow": {
      "types": "./types/webviewWindow.d.ts",
      "default": "./src/webviewWindow.js"
    },
    "./mocks": {
      "types": "./types/mocks.d.ts",
      "default": "./src/mocks.js"
    },
    "./image": {
      "types": "./types/image.d.ts",
      "default": "./src/image.js"
    },
    "./menu": {
      "types": "./types/menu.d.ts",
      "default": "./src/menu.js"
    },
    "./tray": {
      "types": "./types/tray.d.ts",
      "default": "./src/tray.js"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p . --noEmit",
    "build:types": "tsc -p tsconfig.types.json"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 本地 feed：tools/verify-pack.ps1 先 dotnet pack 到这里，本工程才还原得到 OrielWeb。
         保留 nuget.org（不写 <clear />）：OrielWeb 自己的依赖（WebView2Aot）要从那里取。 -->
    <add key="orielweb-local" value="..\..\dist\nuget" />
  </packageSources>
</configuration>

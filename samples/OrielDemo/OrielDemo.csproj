<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe：不显示命令行窗口 -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>OrielDemo</RootNamespace>
    <!-- Native AOT 发布：dotnet publish -c Release -r win-x64 -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 示例应用不是 NuGet 包：dotnet pack OrielWeb.slnx 时不要为它产包 -->
    <IsPackable>false</IsPackable>
    <!-- 应用图标：资源管理器、任务栏、Alt-Tab 都取自它。窗口类未设置 hIcon（见 Win32WindowHost），
         因此窗口图标也回落到这里的 exe 图标。**这只解决 Windows**——Linux/macOS 没有"从 exe 取图标"
         这回事，那两个平台靠下面复制出去的 app.png + 代码里的 WithIcon（见 README「应用图标」）。 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 窗口/Dock 图标（Linux/macOS 用）。必须作为**文件**随产物分发：那两个平台的图标接口
         只吃文件路径，而 ELF/Mach-O 里没有图标可取。程序运行时按 AppContext.BaseDirectory
         拼绝对路径引用它（相对路径在 macOS 从 .app 启动时会按 cwd（/）解析）。
         与 app.ico 同源，都由 tools/make-icons.ps1 生成。 -->
    <None Include="app.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- app.ico 同样随产物分发：Windows 上 <ApplicationIcon> 只作用于 exe 自身，
         而托盘/窗口图标现在走托管解码（OrielImageCodec），需要一个**可读的文件路径**。
         ICO 在 Windows 上是原生格式（多尺寸、质量最好），比 PNG 更适合那里。 -->
    <None Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OrielWeb\OrielWeb.csproj" />
    <!-- 契约自检（selftest 开关）的实现。它包含 26 个自检与那套测试夹具配置；
         放在这里是为了让"跨平台契约测试"有一个不属于示例工程的归属。
         仍然编进同一个二进制：CI 的 verify 脚本 publish 一次、跑完三个阶段的假设不变。 -->
    <ProjectReference Include="..\..\tests\OrielWeb.Conformance\OrielWeb.Conformance.csproj" />
    <!-- 分析器不随 ProjectReference 传递：消费项目需直接引用生成器 -->
    <ProjectReference Include="..\..\src\OrielWeb.Generators\OrielWeb.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 前端资源内嵌进程序集，运行期由自定义 scheme oriel://app.oriel/ 提供。

         **为什么这里要自己声明，而不是"零配置"**：本工程用 ProjectReference 引用库，而包的
         build/ 与 buildTransitive/ **不随 ProjectReference 分发**（那是 NuGet 包的机制），
         所以仓库内的示例拿不到自动内嵌——零配置只在从包消费时生效，见 samples/OrielMinimal
         与 tools/verify-pack.ps1 的场景 A。

         自己声明就必须带 LogicalName 的显式 '/' 分隔符（下面这行与 targets 自动生成的那行逐字符一致）。
         注意 %(RecursiveDir) 在 Windows 上带反斜杠，所以显式归一成 '/'——不归一的话子目录资源名会是
         "wwwroot/assets\img\logo.svg" 这种混合形态（库读取时会归一，但资源名就不是文档承诺的形状了）。
         不带 LogicalName 的旧写法已删除：构建期会报 ORIELWEB001。 -->
         <EmbeddedResource Include="wwwroot\**\*"
                       LogicalName="$(AssemblyName).wwwroot/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 前端包（packages/api/src）**直接内嵌**，落在 wwwroot/vendor/orielweb-api/ 下。

         **不复制、不提交副本**：页面 import 的就是包的源码本身，从根上不存在"副本过期"这种漂移。
         复制一份到 wwwroot 再提交是更常见的做法，但那会引入一个永久的同步负担——
         改了包忘了拷，页面跑的是旧代码，而症状是"包的新功能在 demo 里看不到"。

         为什么用相对路径 import 而不是裸标识符 `@orielweb/api/core`：
         demo **没有打包器**，浏览器/WebView 不认 node_modules 解析。真实项目走两条路之一——
         有打包器就用裸标识符，没有就配 import map。两条路都写在 packages/api/README.md 里。
         （import map 在 WebView2 上可用，但 WebKitGTK 的支持版本不确定，所以示例不依赖它。） -->
    <EmbeddedResource Include="..\..\packages\api\src\*.js"
                      LogicalName="$(AssemblyName).wwwroot/vendor/orielweb-api/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
